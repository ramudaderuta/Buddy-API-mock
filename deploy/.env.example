# Copy to .env and edit before starting:
#   cp .env.example .env

# Required. Administrator console password (Web UI login only; not the relay API key).
API_MOCK_ADMIN_PASSWORD=replace-with-a-long-local-password

# Required. Relay API key for POST /v1/chat/completions clients.
# Send as: Authorization: Bearer <value>  or  X-API-Key: <value>
# This is NOT an upstream provider key; upstream keys are added in the console account pool.
API_MOCK_API_KEY=replace-with-a-long-relay-api-key

# Optional. WorkBuddy user ID forwarded only to the configured upstream.
# Keep this local to .env; do not commit a real value.
# API_MOCK_WORKBUDDY_USER_ID=00000000-0000-0000-0000-000000000000

# Optional. Defaults to docker.io/ramudaderuta/buddy-api-mock:latest
# API_MOCK_IMAGE=docker.io/ramudaderuta/buddy-api-mock:latest

# Optional. Read a private system-instructions file from inside the container.
# Do not commit the source file or its contents.
# API_MOCK_MODEL_INSTRUCTIONS_FILE=/data/model_instructions.private.md

# Optional. Read a private verified WorkBuddy request-header profile from the data volume.
# Do not commit the file or its contents.
# API_MOCK_WORKBUDDY_PROFILE_FILE=/data/workbuddy_profile.private.json
