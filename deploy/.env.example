# Copy to .env and edit before starting:
#   cp .env.example .env

# Required. Administrator console password (Web UI login only; not the relay API key).
API_MOCK_ADMIN_PASSWORD=replace-with-a-long-local-password

# Required. Relay API key for POST /v1/chat/completions clients.
# Send as: Authorization: Bearer <value>  or  X-API-Key: <value>
# This is NOT an upstream provider key; upstream keys are added in the console account pool.
API_MOCK_API_KEY=replace-with-a-long-relay-api-key

# Optional. WorkBuddy user ID forwarded only to the configured upstream.
# Keep this local to .env; do not commit a real value.
# API_MOCK_WORKBUDDY_USER_ID=00000000-0000-0000-0000-000000000000

# Optional. Defaults to docker.io/ramudaderuta/buddy-api-mock:latest
# API_MOCK_IMAGE=docker.io/ramudaderuta/buddy-api-mock:latest

# Optional. Host directory bind-mounted read-only at /private-profile.
# Keep it outside Git. The default is ./.private/workbuddy-profile relative to deploy/.
# API_MOCK_PRIVATE_PROFILE_DIR=./.private/workbuddy-profile

# Optional. Use the two private files from that read-only bind mount.
# API_MOCK_MODEL_INSTRUCTIONS_FILE=/private-profile/model_instructions.private.md
# API_MOCK_WORKBUDDY_PROFILE_FILE=/private-profile/workbuddy_profile.private.json

# Optional. Disabled by default. When enabled, writes request-shape captures to
# the private named volume after lightweight rule-based redaction of message
# text, tool arguments, URLs, credentials, and common identifiers. Captures are
# still private operational data and must not be committed or shared publicly.
# API_MOCK_OUTGOING_CAPTURE_DIR=/outgoing-captures

# Optional. Render a private, unmodified WorkBuddy prompt template instead of
# a captured, fully expanded prompt. Copy the template into the private profile
# directory, set API_MOCK_MODEL_INSTRUCTIONS_FILE to its container path, then
# set only the variables needed for your local environment. Values may contain
# private content and must remain in the ignored deploy/.env file.
# API_MOCK_PROMPT_ARTIFACT_DIRECTORY_PATH=
# API_MOCK_PROMPT_BINARY_CONTEXT=
# API_MOCK_PROMPT_CLAW_MEMORY_1=
# API_MOCK_PROMPT_CLAW_MEMORY_2=
# API_MOCK_PROMPT_CLAW_MEMORY_3=
# API_MOCK_PROMPT_DATA_FOLDER_NAME=
# API_MOCK_PROMPT_EXPERT_MANAGEMENT=
# API_MOCK_PROMPT_MODEL_NAME=
# API_MOCK_PROMPT_PLUGIN_AGENT_PROMPT=
# API_MOCK_PROMPT_PRODUCT_NAME=
# API_MOCK_PROMPT_RESPONSE_LANGUAGE=
# API_MOCK_PROMPT_SUB_AGENT_PROMPT=
# API_MOCK_PROMPT_TOOL_RESULT_PRESENTATION_PROMPT=
# API_MOCK_PROMPT_USER_LOCAL_MEMORY_CONTENT=
# API_MOCK_PROMPT_USER_MEMORY_CONTENT=
# API_MOCK_PROMPT_WORKING_MEMORY_CONTENT=
